generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgeGroup {
  U10
  U11
  U12
  U13
}

enum TrainingDay {
  MONDAY    @map("Lundi")
  TUESDAY   @map("Mardi")
  WEDNESDAY @map("Mercredi")
  THURSDAY  @map("Jeudi")
  FRIDAY    @map("Vendredi")
}

enum DevelopmentTheme {
  KEEPING_BALL @map("Conserver le ballon")
  PROGRESSING  @map("Progresser ensemble")
  FINISHING    @map("Finir les actions")
  RECOVERING   @map("Récupérer rapidement")
  PROTECTING   @map("Protéger son but")
}

enum ObservationEventType {
  training
  match
}

enum MatchVenue {
  home
  away
}

enum MatchStatus {
  scheduled
  played
}

enum MessageAuthorRole {
  coach
  player
}

// Compte de l'application. Historiquement « éducateur » (le seul rôle) ; désormais discriminé
// par `role` : un compte `coach` a une équipe, un plan, un effectif... ; un compte `player`
// (tuteur/joueur) n'a que `linkedPlayerId` -- le joueur de l'effectif d'un coach qu'il suit --
// et ne voit que ce suivi (voir PlayerDashboardService). Le nom du modèle et de la table
// (`educators`) reste, ainsi que `sessions.educator_id`, pour éviter une migration de renommage
// massive ; c'est bien le modèle de compte pour les deux rôles.
model Educator {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique
  displayName        String                   @map("display_name")
  passwordHash       String                   @map("password_hash")
  // "coach" | "player". `getEducatorForSession` ne résout que les comptes "coach", donc les
  // routes API éducateur rejettent automatiquement un jeton de compte joueur.
  role               String                   @default("coach")
  // Rempli quand le lien reçu par e-mail à l'inscription a été cliqué. `null` = compte non
  // encore confirmé (la session existe déjà -- on ne bloque pas la connexion, voir
  // EmailVerificationService -- mais l'appli affiche un rappel tant que c'est vide).
  emailVerifiedAt    DateTime?                @map("email_verified_at")
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  // Renseigné uniquement pour un compte "player" : l'enfant actuellement affiché parmi ceux que le
  // compte suit (voir PlayerFollowerLink). Plus unique : deux parents peuvent suivre le même enfant.
  linkedPlayerId     String?                  @map("linked_player_id") @db.Uuid
  linkedPlayer       Player?                  @relation("PlayerFollowers", fields: [linkedPlayerId], references: [id], onDelete: Cascade)
  // Renseigné pour un compte "assistant" (l'éducateur dont il rejoint l'équipe) et pour un espace
  // d'équipe "team" (l'éducateur qui l'a créé).
  ownerEducatorId    String?                  @map("owner_educator_id") @db.Uuid
  owner              Educator?                @relation("TeamStaff", fields: [ownerEducatorId], references: [id], onDelete: Cascade)
  staff              Educator[]               @relation("TeamStaff")
  staffInvites       StaffInvite[]
  invitesCreated     PlayerInvite[]
  followedPlayers    PlayerFollowerLink[]
  followRequests     PlayerFollowRequest[]
  // Fiche profil de l'éducateur (page /profil). Tous optionnels : renseignés après l'inscription,
  // qui ne demande que nom / e-mail / mot de passe. `birthDate` est stocké en texte ISO
  // (`YYYY-MM-DD`) plutôt qu'en `DateTime` -- une date de naissance n'a pas d'heure ni de fuseau,
  // et l'app manipule déjà ses dates en texte libre ailleurs (MatchRecord.dateLabel).
  birthDate          String?                  @map("birth_date")
  club               String?
  // Club rejoint par un code (partage d'exercices entre éducateurs). Indépendant du champ libre
  // `club` du profil, qui ne donne accès à rien.
  clubId             String?                  @map("club_id") @db.Uuid
  sharingClub        Club?                    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  country            String?
  address            String?
  phone              String?
  diploma            String?
  seasonFormat       String?                  @map("season_format")
  // Profil de coach : valeurs contrôlées par EducatorProfileService (playStyles côté domaine).
  // Cycle de 4 semaines en cours : les écrans de planification ne lisent que ses séances.
  currentCycle       Int                      @default(1) @map("current_cycle")
  playStyle          String?                  @map("play_style")
  preferredFormation String?                  @map("preferred_formation")
  team               Team?
  diagnostic         Diagnostic?
  seasonProgram      SeasonProgram?
  notifications      Notification[]
  pushDevices        PushDevice[]
  sessions           Session[]
  trainingSessions   TrainingSessionRecord[]
  observations       ObservationRecord[]
  players            Player[]
  matches            MatchRecord[]
  tournaments        TournamentRecord[]
  plateaux           PlateauRecord[]
  personalExercises  PersonalExerciseRecord[]
  playerEvaluations  PlayerEvaluationRecord[]
  messages           MessageRecord[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([ownerEducatorId])
  @@index([clubId])
  @@map("educators")
}

// Club partagé entre éducateurs : chacun voit les exercices personnels des autres membres et peut
// les copier dans sa bibliothèque. On le rejoint avec `joinCode`, transmis par un membre.
model Club {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  joinCode  String     @unique @map("join_code")
  members   Educator[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("clubs")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  educatorId   String   @map("educator_id") @db.Uuid
  educator     Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  // Équipe choisie par l'éducateur dans cette session : l'un de ses espaces d'équipe (compte
  // "team"), `null` pour sa première équipe. Vérifié à chaque lecture plutôt que par clé étrangère :
  // un espace supprimé ramène simplement sur la première équipe.
  activeTeamId String?  @map("active_team_id") @db.Uuid

  @@index([educatorId])
  @@map("sessions")
}

// Saison guidée de l'éducateur (ou de l'espace d'équipe) : ses thèmes prioritaires et la semaine
// de départ. Les 36 semaines se recalculent à partir de là (buildPrioritizedSeason), rien d'autre
// n'est stocké.
// Alerte affichée dans l'app (cloche, pastilles « non lu ») et envoyée en push sur le téléphone.
// `threadPlayerId` : fil de messages concerné, pour tout marquer lu à l'ouverture du fil.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  recipient      Educator  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String
  link           String
  threadPlayerId String?   @map("thread_player_id") @db.Uuid
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

// Téléphone qui reçoit les notifications push (jeton Expo).
model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  educatorId String   @map("educator_id") @db.Uuid
  educator   Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([educatorId])
  @@map("push_devices")
}

model SeasonProgram {
  id         String             @id @default(uuid()) @db.Uuid
  educatorId String             @unique @map("educator_id") @db.Uuid
  educator   Educator           @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  priorities DevelopmentTheme[]
  startDate  DateTime           @map("start_date") @db.Date
  // Créneaux récurrents [{ day, time, location }] (voir training-schedule.ts côté domaine) : heure
  // et lieu de chaque jour d'entraînement, repris par toutes les séances de la saison.
  schedule   Json?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@map("season_programs")
}

model Diagnostic {
  id                String   @id @default(uuid()) @db.Uuid
  educatorId        String   @unique @map("educator_id") @db.Uuid
  educator          Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  availability      Int
  scanning          Int
  progression       Int
  reactionAfterLoss Int      @map("reaction_after_loss")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("diagnostics")
}

// Historique des séances validées par l'éducateur (contrairement à Team/Diagnostic, qui n'ont
// qu'un seul enregistrement par éducateur, une séance en crée un nouveau à chaque validation).
// `blocks` ne stocke que de quoi retrouver chaque activité dans le catalogue du domaine
// (`findTrainingActivity`) -- pas l'activité complète, déjà dupliquée dans ce catalogue.
// Réponse d'un joueur convoqué à un entraînement tant qu'il ne s'est pas manifesté : présent par
// défaut (il signale seulement ses absences) ou à demander.
enum AttendanceDefault {
  present
  ask
}

model TrainingSessionRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  educatorId         String           @map("educator_id") @db.Uuid
  educator           Educator         @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  title              String
  ageGroup           AgeGroup         @map("age_group")
  playerCount        Int              @map("player_count")
  theme              DevelopmentTheme
  intention          String
  blocks             Json
  // Créneau de la séance dans le cycle de 4 semaines du plan de progression : `weekNumber` (1 à 4,
  // aligné sur DevelopmentPlan.weeks) et `slot` (index 0-basé dans les jours d'entraînement de
  // l'équipe). Une seule séance par créneau (contrainte d'unicité) : la (re)générer remplace la
  // précédente. Le calendrier du tableau de bord s'en sert pour ouvrir la bonne séance ou signaler
  // « non générée ».
  cycleNumber        Int              @default(1) @map("cycle_number")
  weekNumber         Int              @default(1) @map("week_number")
  slot               Int              @default(0)
  // Rendez-vous réel (date + heure), lieu et description -- même principe que MatchRecord
  // ci-dessous, affichés sur la fiche détail que voit le joueur/tuteur. `meetingAt` est un vrai
  // horodatage (saisi via un datepicker+heure côté coach) et non un horaire en texte libre comme
  // MatchRecord.meetingTime : contrairement au match, une séance n'a par ailleurs aucune autre
  // date (weekNumber/slot ne placent la séance que dans le cycle, jamais sur un jour précis).
  meetingAt          DateTime?        @map("meeting_at")
  // Convocation envoyée (à la main ou automatiquement) : avant, la séance est seulement
  // « programmée » côté joueur, sans réponse possible.
  convokedAt         DateTime?        @map("convoked_at")
  location           String?
  description        String?
  // Présence à cette séance (id + nom de joueur dupliqués, voir AttendanceEntry côté domaine et
  // MatchRecord.lineup pour le même principe) -- nullable : une séance validée avant
  // l'introduction du suivi de présence n'en a pas, distingué d'une liste vide (`[]`, présence
  // saisie mais personne de présent) dans les agrégats de /statistiques.
  attendance         Json?
  // Durée de préparation mesurée par l'écran (indicateur MVP « première séance en moins de 10 min »),
  // gardée de la création : ré-enregistrer la séance ne la change pas.
  preparationSeconds Int?             @map("preparation_seconds")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([educatorId, cycleNumber, weekNumber, slot], name: "training_session_slot")
  @@index([educatorId])
  @@map("training_sessions")
}

// Historique des observations validées. `players`/`signals`/`ratings`/`summary` sont stockés
// tels quels (JSON), sans intégrité référentielle vers `Player` ci-dessous : une observation
// reste une photo figée d'un instant, pas une vue dynamique sur l'effectif actuel (un joueur
// renommé ou retiré plus tard ne doit pas modifier les observations passées).
model ObservationRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  educatorId          String               @map("educator_id") @db.Uuid
  educator            Educator             @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  eventType           ObservationEventType @map("event_type")
  title               String
  dateLabel           String               @map("date_label")
  players             Json
  ratings             Json
  signals             Json
  note                String?
  summary             Json
  // Rattache l'observation au match préparé qu'elle concerne, quand elle en vient (voir
  // MatchRecord) -- optionnel : une observation de séance n'a pas de match, et `onDelete:
  // SetNull` plutôt que `Cascade` puisqu'une observation déjà saisie doit survivre à la
  // suppression du match qui l'a motivée.
  matchId             String?              @map("match_id") @db.Uuid
  match               MatchRecord?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  // Indicateurs MVP (docs/mvp.md) : durée de saisie mesurée par l'appli, de la première
  // évaluation à la validation, et réponse de l'éducateur à la proposition d'ajustement
  // ("accepted" | "declined", `null` tant qu'il n'a pas répondu).
  entrySeconds        Int?                 @map("entry_seconds")
  adjustmentDecision  String?              @map("adjustment_decision")
  adjustmentDecidedAt DateTime?            @map("adjustment_decided_at")
  createdAt           DateTime             @default(now()) @map("created_at")

  @@index([educatorId])
  @@index([matchId])
  @@map("observations")
}

model Team {
  id                  String             @id @default(uuid()) @db.Uuid
  educatorId          String             @unique @map("educator_id") @db.Uuid
  educator            Educator           @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name                String
  ageGroup            AgeGroup           @map("age_group")
  // Format de jeu (foot à 4 jusqu'à foot à 11) : un entier borné plutôt qu'un enum Postgres,
  // comme `playerCount`/`sessionsPerWeek` -- ce n'est pas une énumération de valeurs nommées,
  // juste une plage validée côté domaine (voir `gameFormats` dans @evolyfoot/domain).
  gameFormat          Int                @default(8) @map("game_format")
  playerCount         Int                @map("player_count")
  sessionsPerWeek     Int                @map("sessions_per_week")
  trainingDays        TrainingDay[]      @map("training_days")
  // Convocations aux entraînements : envoi automatique N jours avant le rendez-vous (0 = dès la
  // création de la séance, null = l'éducateur les envoie lui-même) et réponse par défaut.
  // `attendanceDefault` null = pas encore choisi : l'appli demande à l'éducateur.
  convocationLeadDays Int?               @map("convocation_lead_days")
  attendanceDefault   AttendanceDefault? @map("attendance_default")
  // Joueurs des entraînements : tableau d'ids, null = tout l'effectif.
  trainingPlayerIds   Json?              @map("training_player_ids")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@map("teams")
}

// Effectif nominatif de l'éducateur (contrairement à `Team.playerCount`, un simple total).
// Rattaché directement à l'éducateur plutôt qu'à `Team` : un éducateur peut renseigner ses
// joueurs avant même d'avoir terminé l'onboarding de son équipe, et la liste ne doit pas
// disparaître si l'équipe est un jour recréée. CRUD complet (contrairement à l'historique
// append-only de TrainingSessionRecord/ObservationRecord) : un joueur peut être renommé ou
// retiré à tout moment.
model Player {
  id             String                   @id @default(uuid()) @db.Uuid
  educatorId     String                   @map("educator_id") @db.Uuid
  educator       Educator                 @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  // Prénom et nom séparés (plutôt qu'un `name` unique) : la fiche joueur les distingue désormais
  // (formulaire d'ajout/de fiche détail) ; `lastName` garde un défaut "" pour les joueurs créés
  // avant l'introduction du champ (voir la migration de rétro-compatibilité). Tous les autres
  // usages (composition de match, présence, messagerie...) continuent de ne voir qu'un nom
  // complet, calculé par le mapper (voir toPersistedPlayer côté base).
  firstName      String                   @map("first_name")
  lastName       String                   @default("") @map("last_name")
  // Fiche joueur : tous optionnels. `photo` stocke une image (data URL) redimensionnée côté
  // client -- pas de stockage d'objets ni de CDN pour l'instant. `birthDate` en texte ISO
  // (`YYYY-MM-DD`), même choix que pour la fiche éducateur.
  photo          String?
  birthDate      String?                  @map("birth_date")
  phone          String?
  email          String?
  // Profil sportif, tous optionnels : valeurs contrôlées par RosterService (playerPositions,
  // playerFeet côté domaine). Le numéro reste un texte, jamais utilisé dans un calcul.
  position       String?
  jerseyNumber   String?                  @map("jersey_number")
  preferredFoot  String?                  @map("preferred_foot")
  strengths      String?
  workAreas      String?                  @map("work_areas")
  // Historique borné d'évaluations datées (voir playerEvaluationMaxPerSeason côté domaine),
  // plus « une seule par joueur » : d'où la relation 1-N ci-dessous au lieu d'un `?`.
  evaluations    PlayerEvaluationRecord[]
  // Comptes dont c'est l'enfant affiché (Educator.linkedPlayerId) ; la liste complète des comptes
  // qui suivent ce joueur est dans `followerLinks`.
  followers      Educator[]               @relation("PlayerFollowers")
  followerLinks  PlayerFollowerLink[]
  followRequests PlayerFollowRequest[]
  invites        PlayerInvite[]
  messages       MessageRecord[]
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@index([educatorId])
  @@map("players")
}

// Enfants suivis par un compte tuteur/joueur : un compte peut suivre plusieurs enfants (une
// discussion par enfant), et un enfant peut être suivi par plusieurs comptes (les deux parents).
model PlayerFollowerLink {
  accountId String   @map("account_id") @db.Uuid
  account   Educator @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playerId  String   @map("player_id") @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([accountId, playerId])
  @@index([playerId])
  @@map("player_followers")
}

// Demande d'un compte tuteur/joueur à suivre un joueur, faite par le lien d'invitation : aucun accès
// à l'enfant tant que l'éducateur ne l'a pas acceptée (elle devient alors un PlayerFollowerLink).
model PlayerFollowRequest {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Educator @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playerId  String   @map("player_id") @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, playerId])
  @@index([playerId])
  @@map("player_follow_requests")
}

// Invitation générée par un coach pour qu'un tuteur crée un compte lié à un joueur de son
// effectif. Le jeton n'est stocké que haché (comme Session.tokenHash) ; `consumedAt` marque la
// consommation (usage unique).
// Invitation éducateur -> adjoint. Seule l'empreinte du jeton est stockée.
model StaffInvite {
  id         String    @id @default(uuid()) @db.Uuid
  educatorId String    @map("educator_id") @db.Uuid
  educator   Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("staff_invites")
}

model PlayerInvite {
  id         String    @id @default(uuid()) @db.Uuid
  educatorId String    @map("educator_id") @db.Uuid
  educator   Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  playerId   String    @map("player_id") @db.Uuid
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  // Lien en clair, pour que l'éducateur le retrouve et le renvoie : il ne donne accès à rien sans
  // son accord (voir PlayerFollowRequest). Null pour les invitations d'avant ce choix.
  token      String?
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@index([playerId])
  @@map("player_invites")
}

// Fil de discussion coach <-> joueur/tuteur -- un seul fil par joueur (voir le commentaire dans
// message.ts côté domaine), pas de conversations multiples ni de groupe. `authorRole` distingue
// qui a écrit (le compte "player" n'a pas d'accès direct à `Educator`, donc pas de FK vers un
// auteur -- même principe que AttendanceEntry, qui duplique playerName plutôt que de référencer
// un compte). `educatorId` + `playerId` identifient le fil, comme PlayerInvite ci-dessus.
model MessageRecord {
  id         String            @id @default(uuid()) @db.Uuid
  educatorId String            @map("educator_id") @db.Uuid
  educator   Educator          @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  playerId   String            @map("player_id") @db.Uuid
  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  authorRole MessageAuthorRole @map("author_role")
  authorName String            @map("author_name")
  text       String
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([educatorId, playerId, createdAt])
  @@map("messages")
}

// Lien de confirmation envoyé par e-mail à l'inscription. Même forme que PlayerInvite (token à
// usage unique, expiration, consommation) : un éducateur peut en avoir plusieurs au fil du temps
// (nouvelle demande après expiration), seule la plus récente non consommée est active.
model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  educatorId String    @map("educator_id") @db.Uuid
  educator   Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("email_verifications")
}

// Préparation d'un match : composition positionnée sur le terrain (`lineup`, voir
// MatchLineupAssignment côté domaine) et capitaine. CRUD complet comme `Player` (pas un
// historique append-only comme TrainingSessionRecord/ObservationRecord) : la composition se
// modifie librement jusqu'au coup d'envoi. `lineup` ne référence les joueurs que par id + nom
// dupliqué (jamais de clé étrangère vers `Player`), même principe que ObservationRecord.players
// -- un joueur renommé ou retiré de l'effectif après coup ne doit pas modifier une composition
// déjà préparée ou jouée.
// Lien de réinitialisation de mot de passe : seul le hash du jeton est stocké.
model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  educatorId String    @map("educator_id") @db.Uuid
  educator   Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("password_resets")
}

model MatchRecord {
  id                   String              @id @default(uuid()) @db.Uuid
  educatorId           String              @map("educator_id") @db.Uuid
  educator             Educator            @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  opponent             String
  dateLabel            String              @map("date_label")
  // Vraie date ET heure du coup d'envoi, dérivée du datepicker de création (datetime-local) --
  // utilisée pour trier/regrouper par semaine (voir PlayerDashboardService et les pages listes
  // côté coach) et pour calculer le rendez-vous (voir meetingOffsetMinutes ci-dessous). Nullable :
  // un match créé avant l'introduction de ce champ n'en a pas, seul `dateLabel` (texte libre saisi
  // à l'époque) reste fiable pour lui.
  date                 DateTime?
  // Rendez-vous (avant le coup d'envoi -- échauffement...), calculé automatiquement à
  // `date - meetingOffsetMinutes` quand les deux sont renseignés (voir matchMeetingTime côté
  // domaine) : le coach indique juste "X minutes avant le match" plutôt que de ressaisir une
  // heure. `meetingTime` (texte libre) reste le repli pour un match créé avant l'introduction de
  // `date`/`meetingOffsetMinutes`, ou dont le coach a saisi un rendez-vous à une heure qui ne suit
  // pas cette règle (jour différent, par exemple).
  meetingOffsetMinutes Int?                @map("meeting_offset_minutes")
  meetingTime          String?             @map("meeting_time")
  location             String?
  description          String?
  venue                MatchVenue
  gameFormat           Int                 @map("game_format")
  // Identifiant de la formation choisie (ex. "4-3-3", voir listFormations côté domaine) parmi
  // celles du format de jeu -- nullable : un match préparé avant l'introduction du choix
  // multiple n'en a pas, et doit se replier sur la première formation de son format de jeu
  // plutôt qu'échouer (voir formationSlots côté domaine, et toPersistedMatch côté mappers).
  formationId          String?             @map("formation_id")
  status               MatchStatus         @default(scheduled)
  lineup               Json                @default("[]")
  captainPlayerId      String?             @map("captain_player_id")
  // Sur le banc, sans poste -- tableau d'ids joueur (voir MatchPlan.substitutePlayerIds côté
  // domaine). Nullable : un match préparé avant l'introduction du banc n'en a pas.
  substitutePlayerIds  Json?               @map("substitute_player_ids")
  // Présence à ce match -- distincte de `lineup` (qui joueur est *prévu* à quel poste) : un
  // joueur peut être prévu dans la composition et ne pas s'être présenté, ou inversement.
  // Nullable pour la même raison que TrainingSessionRecord.attendance ci-dessus.
  attendance           Json?
  // Résultat saisi après le match : nuls tant qu'il n'est pas renseigné. `playerStats` suit
  // MatchPlayerStat côté domaine, noms dupliqués comme dans `lineup`.
  // Système supposé de l'adversaire, pour l'analyse d'avant-match. Facultatif.
  opponentFormationId  String?             @map("opponent_formation_id")
  goalsFor             Int?                @map("goals_for")
  goalsAgainst         Int?                @map("goals_against")
  playerStats          Json?               @map("player_stats")
  // Joueurs concernés (voir concerned-players.ts côté domaine) : tableau d'ids, null = tout
  // l'effectif ou, pour un match créé avant ce choix, la composition.
  selectedPlayerIds    Json?               @map("selected_player_ids")
  // Dernier envoi de la convocation (null tant qu'elle n'est pas partie).
  convokedAt           DateTime?           @map("convoked_at")
  observations         ObservationRecord[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([educatorId])
  @@map("matches")
}

// Fiche simple (nom, date, bilan) comptée à part des matchs dans /statistiques -- pas de
// composition ni de matchs individuels rattachés, contrairement à MatchRecord.
// `date` : même principe que MatchRecord ci-dessus (jour calendaire, nullable pour les fiches
// créées avant son introduction), pour trier/regrouper tournois et plateaux avec matchs et
// séances.
// `location`/`description` : mêmes champs libres que MatchRecord, modifiables indépendamment
// depuis la fiche détail (voir MatchService.updateDetails) -- affiche tournois/plateaux sous la
// même forme qu'un match (fiche cliquable, lieu, description).
model TournamentRecord {
  id                String    @id @default(uuid()) @db.Uuid
  educatorId        String    @map("educator_id") @db.Uuid
  educator          Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name              String
  dateLabel         String    @map("date_label")
  date              DateTime?
  location          String?
  description       String?
  result            String?
  // Joueurs concernés (tableau d'ids, null = tout l'effectif), convocation et réponses : même
  // principe que TrainingSessionRecord.
  selectedPlayerIds Json?     @map("selected_player_ids")
  convokedAt        DateTime? @map("convoked_at")
  attendance        Json?
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("tournaments")
}

// Fiche simple d'un plateau (rassemblement U6–U11) -- même forme que TournamentRecord, comptée à
// part dans /statistiques.
model PlateauRecord {
  id                String    @id @default(uuid()) @db.Uuid
  educatorId        String    @map("educator_id") @db.Uuid
  educator          Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name              String
  dateLabel         String    @map("date_label")
  date              DateTime?
  location          String?
  description       String?
  result            String?
  // Même principe que TournamentRecord.
  selectedPlayerIds Json?     @map("selected_player_ids")
  convokedAt        DateTime? @map("convoked_at")
  attendance        Json?
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("plateaux")
}

// Message envoyé depuis le formulaire de contact du site vitrine (public, sans compte). Pas d'e-mail
// sortant pour l'instant : les messages sont simplement stockés et relus depuis /admin.
// Exercice créé ou importé par un éducateur. `kind` et `theme` sont validés côté domaine
// (validatePersonalExercise) ; `photo` est une data URL d'image.
model PersonalExerciseRecord {
  id           String   @id @default(uuid()) @db.Uuid
  educatorId   String   @map("educator_id") @db.Uuid
  educator     Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  kind         String
  theme        String
  title        String
  objective    String
  organization String
  instruction  String
  observable   String
  photo        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("personal_exercises")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

// Évaluation courante d'un joueur sur les 7 aspects de la toile d'araignée (voir
// PlayerEvaluationScores côté domaine) -- un seul enregistrement par joueur, mis à jour en place
// (même principe que Diagnostic, pas un historique append-only) : `playerId` est donc unique,
// pas juste indexé. `onDelete: Cascade` sur `player` (contrairement à ObservationRecord.players,
// qui duplique id+nom sans clé étrangère) : une évaluation n'a de sens que pour un joueur présent
// dans l'effectif courant, ce n'est pas une photo figée d'un instant passé.
// Évaluation d'un joueur à un instant donné (note 0-10 par aspect, voir player-evaluation côté
// domaine). Plusieurs par joueur désormais -- un historique daté et borné (voir
// playerEvaluationMaxPerSeason), plus le patron « un enregistrement remplacé en place ».
model PlayerEvaluationRecord {
  id         String   @id @default(uuid()) @db.Uuid
  educatorId String   @map("educator_id") @db.Uuid
  educator   Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  playerId   String   @map("player_id") @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scores     Json
  // "coach" | "player" : une auto-évaluation reste rattachée à l'éducateur propriétaire du joueur.
  source     String   @default("coach")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([educatorId])
  @@index([playerId])
  @@map("player_evaluations")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgeGroup {
  U10
  U11
  U12
  U13
}

enum TrainingDay {
  MONDAY    @map("Lundi")
  TUESDAY   @map("Mardi")
  WEDNESDAY @map("Mercredi")
  THURSDAY  @map("Jeudi")
  FRIDAY    @map("Vendredi")
}

enum DevelopmentTheme {
  KEEPING_BALL @map("Conserver le ballon")
  PROGRESSING  @map("Progresser ensemble")
  FINISHING    @map("Finir les actions")
  RECOVERING   @map("Récupérer rapidement")
}

enum ObservationEventType {
  training
  match
}

model Educator {
  id               String                   @id @default(uuid()) @db.Uuid
  email            String                   @unique
  displayName      String                   @map("display_name")
  passwordHash     String                   @map("password_hash")
  team             Team?
  diagnostic       Diagnostic?
  sessions         Session[]
  trainingSessions TrainingSessionRecord[]
  observations     ObservationRecord[]
  players          Player[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@map("educators")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  educatorId String   @db.Uuid @map("educator_id")
  educator   Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("sessions")
}

model Diagnostic {
  id                String   @id @default(uuid()) @db.Uuid
  educatorId        String   @unique @db.Uuid @map("educator_id")
  educator          Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  availability      Int
  scanning          Int
  progression       Int
  reactionAfterLoss Int      @map("reaction_after_loss")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("diagnostics")
}

// Historique des séances validées par l'éducateur (contrairement à Team/Diagnostic, qui n'ont
// qu'un seul enregistrement par éducateur, une séance en crée un nouveau à chaque validation).
// `blocks` ne stocke que de quoi retrouver chaque activité dans le catalogue du domaine
// (`findTrainingActivity`) -- pas l'activité complète, déjà dupliquée dans ce catalogue.
model TrainingSessionRecord {
  id          String           @id @default(uuid()) @db.Uuid
  educatorId  String           @db.Uuid @map("educator_id")
  educator    Educator         @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  title       String
  ageGroup    AgeGroup         @map("age_group")
  playerCount Int              @map("player_count")
  theme       DevelopmentTheme
  intention   String
  blocks      Json
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("training_sessions")
}

// Historique des observations validées. `players`/`signals`/`ratings`/`summary` sont stockés
// tels quels (JSON), sans intégrité référentielle vers `Player` ci-dessous : une observation
// reste une photo figée d'un instant, pas une vue dynamique sur l'effectif actuel (un joueur
// renommé ou retiré plus tard ne doit pas modifier les observations passées).
model ObservationRecord {
  id         String               @id @default(uuid()) @db.Uuid
  educatorId String               @db.Uuid @map("educator_id")
  educator   Educator             @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  eventType  ObservationEventType @map("event_type")
  title      String
  dateLabel  String               @map("date_label")
  players    Json
  ratings    Json
  signals    Json
  note       String?
  summary    Json
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([educatorId])
  @@map("observations")
}

model Team {
  id              String        @id @default(uuid()) @db.Uuid
  educatorId      String        @unique @db.Uuid @map("educator_id")
  educator        Educator      @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name            String
  ageGroup        AgeGroup      @map("age_group")
  // Format de jeu (foot à 4 jusqu'à foot à 11) : un entier borné plutôt qu'un enum Postgres,
  // comme `playerCount`/`sessionsPerWeek` -- ce n'est pas une énumération de valeurs nommées,
  // juste une plage validée côté domaine (voir `gameFormats` dans @evolyfoot/domain).
  gameFormat      Int           @default(8) @map("game_format")
  playerCount     Int           @map("player_count")
  sessionsPerWeek Int           @map("sessions_per_week")
  trainingDays    TrainingDay[] @map("training_days")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("teams")
}

// Effectif nominatif de l'éducateur (contrairement à `Team.playerCount`, un simple total).
// Rattaché directement à l'éducateur plutôt qu'à `Team` : un éducateur peut renseigner ses
// joueurs avant même d'avoir terminé l'onboarding de son équipe, et la liste ne doit pas
// disparaître si l'équipe est un jour recréée. CRUD complet (contrairement à l'historique
// append-only de TrainingSessionRecord/ObservationRecord) : un joueur peut être renommé ou
// retiré à tout moment.
model Player {
  id         String   @id @default(uuid()) @db.Uuid
  educatorId String   @db.Uuid @map("educator_id")
  educator   Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([educatorId])
  @@map("players")
}

{
  "expo": {
    "name": "EvolyFoot Coach",
    "slug": "evolyfoot-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "evolyfoot-coach",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b12"
    },
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "EvolyFoot Coach accède à vos photos pour ajouter la photo d’un joueur à sa fiche.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2fd4ff",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evolyfoot.coach",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze", "citymapper"]
      }
    },
    "android": {
      "package": "com.evolyfoot.coach",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070b12"
      }
    }
  }
}

# URL de base de l'API web (Next.js) consommée par l'application mobile.
# Par défaut (si absente), le code utilise http://10.0.2.2:3000, l'alias réseau standard
# de l'émulateur Android vers le localhost de la machine hôte. Pour un appareil physique
# ou iOS, remplace par l'adresse IP locale de la machine qui exécute `pnpm dev:web`
# (ex. http://192.168.1.42:3000), ou par l'URL de déploiement en préproduction/production.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"

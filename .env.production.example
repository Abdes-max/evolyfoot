# Variables lues par docker-compose.yml sur le VPS. Copier en .env à côté de docker-compose.yml
# (jamais commité) et remplir. Voir docs/delivery.md pour le déroulé complet (bootstrap inclus).

POSTGRES_USER="evolyfoot"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="evolyfoot"

# E-mails autorisés à consulter /admin/metrics, séparés par des virgules. Laisser vide (ou
# omettre) refuse l'accès à tout le monde plutôt que de l'ouvrir par défaut.
ADMIN_EMAILS=""

# Adresse publique utilisée dans les liens envoyés par e-mail.
APP_URL="https://evolyfoot.com"

# Relais SMTP Brevo pour l'e-mail transactionnel (confirmation d'adresse, mot de passe oublié --
# voir apps/web/src/server/mailer.ts et docs/delivery.md). Laissé vide, aucun e-mail ne part et
# l'erreur est journalisée, sans casser l'inscription. SMTP_PASSWORD est la clé SMTP Brevo.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Paiement Stripe (abonnements). Clé secrète du compte Stripe (sk_live_...) et secret de signature
# du webhook https://evolyfoot.com/api/billing/webhook (whsec_...). Peuvent aussi venir des secrets
# GitHub du même nom (voir .github/workflows/cd.yml). Vides : paiement désactivé.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "true" : à la fin de l'essai, un coach non abonné est renvoyé vers la page Abonnement.
BILLING_ENFORCED="false"

# Variables lues par docker-compose.yml sur le VPS. Copier en .env à côté de docker-compose.yml
# (jamais commité) et remplir. Voir docs/delivery.md pour le déroulé complet (bootstrap inclus).

POSTGRES_USER="evolyfoot"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="evolyfoot"

# E-mails autorisés à consulter /admin/metrics, séparés par des virgules. Laisser vide (ou
# omettre) refuse l'accès à tout le monde plutôt que de l'ouvrir par défaut.
ADMIN_EMAILS=""

# Relais SMTP pour l'e-mail transactionnel (confirmation d'inscription, invitation tuteur --
# voir apps/web/src/server/mailer.ts). Laissées vides, l'appli retombe sur les valeurs par défaut
# de mailer.ts (Mailhog local) : l'envoi échoue alors silencieusement (juste journalisé), sans
# casser l'inscription elle-même -- mais aucun e-mail ne part réellement. Port 587 (STARTTLS) ou
# 465 (TLS implicite, détecté automatiquement) selon le relais.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

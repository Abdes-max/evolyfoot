# Variables lues par docker-compose.yml sur le VPS. Copier en .env à côté de docker-compose.yml
# (jamais commité) et remplir. Voir docs/delivery.md pour le déroulé complet.

# ghcr.io/<organisation-ou-compte-github>/<nom-du-dépôt>
IMAGE_REPO="ghcr.io/OWNER/REPO"
# Mis à jour automatiquement par le workflow CD à chaque déploiement (sha du commit déployé).
IMAGE_TAG="latest"

POSTGRES_USER="evolyfoot"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="evolyfoot"

# Nom de domaine pointant vers l'IP du VPS (enregistrement DNS A/AAAA), utilisé par Caddy
# pour obtenir automatiquement un certificat TLS.
DOMAIN="evolyfoot.example.com"
